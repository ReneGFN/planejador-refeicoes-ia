{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planejador-refeicoes-ia",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-09-06",
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "AI_ENABLED": "false",
    "SESSIONS_ENABLED": "false",
    "VISION_ENABLED": "false",
    "PERSONALIZATION_ENABLED": "false",
    "DIARY_ENABLED": "false",
    "PANTRY_ENABLED": "false",
    "HISTORY_DELETION_ENABLED": "false",
    "VIDEO_ENABLED": "false",
    "VIDEO_QUOTA_POLICY_JSON": "{}",
    "QUOTA_POLICY_JSON": "{}",
    "MAX_CONTEXT_CHARACTERS": "400"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "planejador-refeicoes-ia",
    // ID reservado para desenvolvimento local. Não é um banco remoto.
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "env": {
    "production": {
      "vars": {
        "GROQ_MODEL": "openai/gpt-oss-20b",
        "AI_ENABLED": "false",
        "SESSIONS_ENABLED": "false",
        "VISION_ENABLED": "false",
        "PERSONALIZATION_ENABLED": "false",
        "DIARY_ENABLED": "false",
        "PANTRY_ENABLED": "false",
        "HISTORY_DELETION_ENABLED": "false",
        "VIDEO_ENABLED": "false",
        "VIDEO_QUOTA_POLICY_JSON": "{}",
        "QUOTA_POLICY_JSON": "{}",
        "MAX_CONTEXT_CHARACTERS": "400"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "planejador-refeicoes-ia",
        "database_id": "fe6371c5-bfb6-497e-94a1-ba467e060ff3",
        "migrations_dir": "migrations"
      }]
    },
    "preview": {
      "vars": {
        "GROQ_MODEL": "openai/gpt-oss-20b",
        "AI_ENABLED": "true",
        "SESSIONS_ENABLED": "true",
        "VISION_ENABLED": "true",
        "PERSONALIZATION_ENABLED": "true",
        "DIARY_ENABLED": "true",
        "PANTRY_ENABLED": "true",
        "HISTORY_DELETION_ENABLED": "true",
        "VIDEO_ENABLED": "false",
        "VIDEO_QUOTA_POLICY_JSON": "{}",
        "QUOTA_POLICY_JSON": "{\"ingress\":{\"visitorDay\":1,\"visitorMinute\":1,\"networkDay\":240,\"networkMinute\":30,\"globalDay\":1000,\"globalMinute\":120,\"dayTokens\":0,\"minuteTokens\":0,\"reserveTokens\":0},\"session\":{\"visitorDay\":1,\"visitorMinute\":1,\"networkDay\":60,\"networkMinute\":10,\"globalDay\":500,\"globalMinute\":60,\"dayTokens\":0,\"minuteTokens\":0,\"reserveTokens\":0},\"generation\":{\"visitorDay\":3,\"visitorMinute\":1,\"networkDay\":12,\"networkMinute\":2,\"globalDay\":20,\"globalMinute\":1,\"dayTokens\":120000,\"minuteTokens\":7000,\"reserveTokens\":6144},\"vision\":{\"visitorDay\":2,\"visitorMinute\":1,\"networkDay\":4,\"networkMinute\":1,\"globalDay\":5,\"globalMinute\":1,\"dayTokens\":30000,\"minuteTokens\":7000,\"reserveTokens\":4096}}",
        "MAX_CONTEXT_CHARACTERS": "1200"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "planejador-refeicoes-ia-preview",
        "database_id": "c4a549cf-8629-44ec-a179-ba9968c2efae",
        "migrations_dir": "migrations"
      }]
    }
  }
}
